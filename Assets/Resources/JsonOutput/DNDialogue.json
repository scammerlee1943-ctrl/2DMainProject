[
  {
    "Id": "dialogue_mainstream_1_1_100",
    "CharacterDataId": "npc_main_guide_01",
    "Description": "\"오, 여행자여! 마침 잘 와줬네...\"",
    "NextDialogueId": "dialogue_mainstream_1_1_200",
    "SelectionNameList": null,
